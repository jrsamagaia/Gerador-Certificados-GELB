{
  "entities": {
    "CertificateTemplate": {
      "title": "CertificateTemplate",
      "description": "Modelo de certificado oficial GELB publicado na nuvem",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "model": { "type": "string", "maxLength": 150 },
        "fileName": { "type": "string", "maxLength": 255 },
        "fileSize": { "type": "number" },
        "orientation": { "type": "string", "enum": ["landscape", "portrait"] },
        "isDefault": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 1000 },
        "previewImageDataUrl": { "type": "string", "maxLength": 800000 },
        "hasChunks": { "type": "boolean" },
        "chunkCount": { "type": "number" },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorEmail": { "type": "string", "maxLength": 255 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "category", "model", "fileName", "fileSize"]
    },
    "TemplateChunk": {
      "title": "TemplateChunk",
      "description": "Fragmento de arquivo binário/PDF para suporte a arquivos de alta fidelidade",
      "type": "object",
      "properties": {
        "templateId": { "type": "string", "maxLength": 128 },
        "chunkIndex": { "type": "number" },
        "totalChunks": { "type": "number" },
        "data": { "type": "string", "maxLength": 800000 },
        "type": { "type": "string", "enum": ["pdf", "preview"] }
      },
      "required": ["templateId", "chunkIndex", "totalChunks", "data", "type"]
    },
    "GelbSettings": {
      "title": "GelbSettings",
      "description": "Configurações institucionais do Grupo Escoteiro Leões de Blumenau",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "logoDataUrl": { "type": "string", "maxLength": 800000 },
        "fontsJson": { "type": "string", "maxLength": 50000 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/templates/{templateId}": {
      "schema": "CertificateTemplate",
      "description": "Coleção de modelos de certificados disponíveis publicamente e gerenciados pela chefia"
    },
    "/templates/{templateId}/chunks/{chunkId}": {
      "schema": "TemplateChunk",
      "description": "Fragmentos dos arquivos PDF e visualizações em alta definição dos modelos"
    },
    "/settings/{settingId}": {
      "schema": "GelbSettings",
      "description": "Configurações globais de identidade visual e tipografia"
    }
  }
}

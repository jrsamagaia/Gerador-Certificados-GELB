rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'model', 'fileName', 'fileSize'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.model is string && data.model.size() > 0 && data.model.size() <= 150
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255
        && data.fileSize is number && data.fileSize >= 0
        && (!('pdfDataUrl' in data) || (data.pdfDataUrl is string && data.pdfDataUrl.size() <= 800000))
        && (!('previewImageDataUrl' in data) || (data.previewImageDataUrl is string && data.previewImageDataUrl.size() <= 800000))
        && (!('orientation' in data) || (data.orientation in ['landscape', 'portrait']))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('hasChunks' in data) || data.hasChunks is bool)
        && (!('chunkCount' in data) || (data.chunkCount is number && data.chunkCount >= 0))
        && (!('authorUid' in data) || (data.authorUid is string && data.authorUid.size() <= 128))
        && (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 255));
    }

    function isValidChunk(data, tplId) {
      return data.keys().hasAll(['templateId', 'chunkIndex', 'totalChunks', 'data', 'type'])
        && data.templateId is string && data.templateId == tplId
        && data.chunkIndex is number && data.chunkIndex >= 0
        && data.totalChunks is number && data.totalChunks >= 1
        && data.data is string && data.data.size() <= 800000
        && data.type is string && (data.type == 'pdf' || data.type == 'preview');
    }

    function isValidSettings(data, sid) {
      return data.id is string && data.id == sid
        && (!('logoDataUrl' in data) || (data.logoDataUrl is string && data.logoDataUrl.size() <= 800000))
        && (!('fontsJson' in data) || (data.fontsJson is string && data.fontsJson.size() <= 50000));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation probe
    match /test/connection {
      allow read: if true;
    }

    // Official Certificate Templates
    match /templates/{templateId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(templateId) && incoming().id == templateId && isValidTemplate(incoming());
      allow update: if isSignedIn() && isValidId(templateId) && isValidTemplate(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(templateId);

      // Chunks subcollection for high-resolution files
      match /chunks/{chunkId} {
        allow get, list: if true;
        allow create: if isSignedIn() && isValidId(templateId) && isValidId(chunkId) && isValidChunk(incoming(), templateId);
        allow update: if isSignedIn() && isValidId(templateId) && isValidId(chunkId) && isValidChunk(incoming(), templateId);
        allow delete: if isSignedIn() && isValidId(templateId) && isValidId(chunkId);
      }
    }

    // Global settings (Official Logo & Typography)
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isSignedIn() && isValidId(settingId) && isValidSettings(incoming(), settingId);
    }

  }
}
